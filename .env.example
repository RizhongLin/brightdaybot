# BrightDayBot Environment Configuration
# Copy this file to .env and replace the placeholder values with your actual tokens and settings
# Never commit your actual .env file - it contains sensitive information

# ================================
# REQUIRED CONFIGURATION
# ================================
# These variables are essential for the bot to function

# Slack App Tokens (get these from https://api.slack.com/apps)
SLACK_BOT_TOKEN="xoxb-your-bot-user-oauth-token-here"
SLACK_APP_TOKEN="xapp-your-app-level-token-here"

# Slack Channel ID where birthday messages will be posted
# To find channel ID: Right-click channel → View channel details → Copy ID
BIRTHDAY_CHANNEL_ID="C0123456789"

# OpenAI API Key for AI message and image generation
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"

# ================================
# OPTIONAL CONFIGURATION
# ================================
# These variables have default values and can be customized

# AI & Message Settings
# Override the default OpenAI model (see config/settings.py DEFAULT_OPENAI_MODEL)
# OPENAI_MODEL=""

# Override the default OpenAI image model (see config/settings.py DEFAULT_IMAGE_MODEL)
# Supported: gpt-image-2 (default), gpt-image-1.5, gpt-image-1, gpt-image-1-mini
# Storage file at data/storage/openai_image_model_settings.json takes precedence;
# admin command `admin image-model set <model>` writes that file.
# OPENAI_IMAGE_MODEL=""

# Max concurrent threads for parallel AI calls — images, teasers, details (default: 4)
# AI_MAX_WORKERS="4"

# Enable/disable AI image generation (default: true)
AI_IMAGE_GENERATION_ENABLED="true"

# Use custom workspace emojis in messages (default: true)
USE_CUSTOM_EMOJIS="true"

# Web Search & Caching
# Cache historical date facts to reduce API calls (default: true)
WEB_SEARCH_CACHE_ENABLED="true"

# Upcoming Events Lookahead
UPCOMING_DAYS_DEFAULT="7"     # Default lookahead for upcoming birthdays (default: 7)
UPCOMING_DAYS_EXTENDED="30"   # Extended lookahead for calendar views (default: 30)

# Backup System Configuration
# Enable external backup system — triggers canvas dashboard update on birthday changes (default: true)
EXTERNAL_BACKUP_ENABLED="true"
MAX_BACKUPS="10"              # Number of backup files to retain (default: 10)

# ================================
# SPECIAL DAYS CONFIGURATION
# ================================

# Enable/disable special day announcements (default: true)
SPECIAL_DAYS_ENABLED="true"

# Personality for special day announcements (default: chronicler)
# SPECIAL_DAYS_PERSONALITY="chronicler"

# Channel for special day announcements (defaults to BIRTHDAY_CHANNEL_ID)
# SPECIAL_DAYS_CHANNEL_ID=""

# Announcement mode: "daily" (per-day) or "weekly" (Monday digest) (default: daily)
# SPECIAL_DAYS_MODE="daily"

# Day of week for weekly digest: 0=Monday through 6=Sunday (default: 0)
# SPECIAL_DAYS_WEEKLY_DAY="0"

# Enable AI image generation for special days (default: false)
# SPECIAL_DAYS_IMAGE_ENABLED="false"

# UN Observances (scraped from un.org using crawl4ai)
# Requires: uv run crawl4ai-setup (see README for setup)
UN_OBSERVANCES_ENABLED="true"
UN_OBSERVANCES_CACHE_TTL_DAYS="180"   # Days before auto-refresh (default: 180, use admin refresh for immediate update)

# UNESCO Observances (scraped from unesco.org)
UNESCO_OBSERVANCES_ENABLED="true"
UNESCO_OBSERVANCES_CACHE_TTL_DAYS="180" # Days before auto-refresh (default: 180)

# WHO Health Days (scraped from who.int)
WHO_OBSERVANCES_ENABLED="true"
WHO_OBSERVANCES_CACHE_TTL_DAYS="180"    # Days before auto-refresh (default: 180)

# Calendarific API — multi-source holiday fetcher (optional)
# Get free API key at: https://calendarific.com
# Free tier: 500 requests/month shared across all sources
# Sources are configured in config/settings.py CALENDARIFIC_SOURCES
CALENDARIFIC_API_KEY=""
CALENDARIFIC_ENABLED="false"
CALENDARIFIC_CACHE_TTL_DAYS="7"   # Days before cache refresh (default: 7)

# External ICS calendar feed subscriptions (managed via admin commands)
# ICS_SUBSCRIPTIONS_ENABLED="false"

# Optional: Dedicated ops channel for canvas dashboard (leave empty to disable)
OPS_CHANNEL_ID=""

# Send backup on every change vs. batched/daily (default: true)
BACKUP_ON_EVERY_CHANGE="true"

# Canvas dashboard in ops channel — auto-updating health/birthday/cache status (default: true)
CANVAS_DASHBOARD_ENABLED="true"

# ================================
# INTERACTIVE FEATURES CONFIGURATION
# ================================
# These features enable interactive engagement with users

# Thread Engagement - Bot reacts to birthday thread replies (default: true)
THREAD_ENGAGEMENT_ENABLED="true"

# Special Day Thread Engagement - Bot responds to special day thread replies (default: true)
SPECIAL_DAY_THREAD_ENABLED="true"
# SPECIAL_DAY_THREAD_MAX_RESPONSES_PER_USER="3"

# Profile Analysis - Use Vision API on profile photos for birthday images (default: true)
# PROFILE_ANALYSIS_ENABLED="true"

# @-Mention Q&A - Bot answers questions when mentioned (default: true)
MENTION_QA_ENABLED="true"
MENTION_RATE_LIMIT_WINDOW="60"
MENTION_RATE_LIMIT_MAX="5"

# @-Mention Tool Agent - Answer mentions via tool calls (real birthday/special-day
# lookups) instead of context stuffing; falls back to legacy prompt (default: true)
MENTION_QA_TOOLS_ENABLED="true"

# Birthday Thread Prompt - Follow-up in birthday threads inviting memories/emojis,
# skipped for quiet celebration style (default: true)
BIRTHDAY_THREAD_PROMPT_ENABLED="true"

# DM Birthday Setup Deprecation - "enabled" (legacy), "nudge" (works + tip pointing
# to /birthday, default), "disabled" (rejected with pointer to /birthday & App Home)
DM_BIRTHDAY_SETUP_MODE="nudge"

# NLP Date Parsing - LLM-based natural language date input (default: false)
# When enabled, accepts inputs like "my birthday is July 14th"
NLP_DATE_PARSING_ENABLED="false"

# Special Day Announcements
# SPECIAL_DAY_MENTION_ENABLED - Include @-here in special day announcements (default: true)
SPECIAL_DAY_MENTION_ENABLED="true"
# GROUNDED_SPECIAL_DAYS_ENABLED - AI writes only a short intro; the quoted official
# source description carries the facts (default: true)
GROUNDED_SPECIAL_DAYS_ENABLED="true"
# MAX_SPECIAL_DAYS_PER_DAY - Cap observances announced per day, official sources
# kept first; 0 = unlimited (default: 0)
MAX_SPECIAL_DAYS_PER_DAY="0"
# SPECIAL_DAY_TOPIC_UPDATE_ENABLED - Update channel topic with today's special days (default: false)
SPECIAL_DAY_TOPIC_UPDATE_ENABLED="false"
# SPECIAL_DAY_CONSOLIDATED_ENABLED - One message for all daily observances vs. separate (default: true)
SPECIAL_DAY_CONSOLIDATED_ENABLED="true"

# ================================
# CUSTOM BOT PERSONALITY SETTINGS
# ================================
# Only used when bot personality is set to 'custom'
# Use admin commands to switch to custom personality, then these values apply

# Custom bot name (used in message generation)
CUSTOM_BOT_NAME="Birthday Wizard"

# Description of the bot's character
CUSTOM_BOT_DESCRIPTION="a magical birthday celebration wizard"

# Writing style for message generation
CUSTOM_BOT_STYLE="magical, whimsical, and full of enchantment"

# Formatting instructions for message generation
CUSTOM_FORMAT_INSTRUCTION="Create a magical spell-like birthday message"

# Additional template extension for message generation
CUSTOM_BOT_TEMPLATE_EXTENSION="Add magical sparkles and enchanted birthday wishes"

# ================================
# SETUP INSTRUCTIONS
# ================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Set up your Slack app with the required permissions (see README.md)
# 4. Run: python app.py